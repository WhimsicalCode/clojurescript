#!/bin/sh

# Tests the cljf launcher and create-clojurific (src/main/js/cljf,
# src/main/js/create-clojurific, with Node.js' test runner), then the npm
# packages: packs them with script/package-npm, installs clojurific into an
# empty project, builds a namespace with npx cljf, and bundles a page loading
# its source, and a JavaScript module importing another, with Vite and the
# plugin. Then scaffolds a project of each create-clojurific template and
# bundles it, and runs the hono project's dev server (vite-plugin-cljs/test/
# dev-server.mjs). The package gets the compiler from Clojars: the project's local
# Maven repository has the jar of this version (script/clojars install), and
# downloads the rest (about 20 MB, and the templates' libraries).
# CLJF_TEST_DOWNLOADS=1 also tests a start with an empty local Maven
# repository, see src/main/js/cljf/test/launcher.test.js.

set -e
cd "$(dirname "$0")/.."

node --test 'src/main/js/cljf/test/*.test.js' 'src/main/js/vite-plugin-cljs/test/*.test.js' 'src/main/js/create-clojurific/test/*.test.js'

script/package-npm
version=$(node -p "require('./builds/npm/package.json').version")
project=$(mktemp -d)
trap 'rm -rf "$project"' EXIT
mkdir -p "$project/src/smoke"
script/clojars install "$project/m2"
printf '{:paths ["src"] :mvn/local-repo "%s"}\n' "$project/m2" > "$project/deps.edn"
printf '(ns smoke.core)\n(println "smoke" (+ 1 2))\n' > "$project/src/smoke/core.cljs"
(
  cd "$project"
  npm init -y > /dev/null
  npm pkg set type=module
  npm install --silent --no-audit --no-fund vite@8.2.2 "$OLDPWD/builds/clojurific-$version.tgz"
  npx cljf classpath | tr ':' '\n' | grep -qx "$project/m2/com/whimsical/clojurific/$version/clojurific-$version.jar"
  npx cljf build '{:main smoke.core :output-dir "out"}'
  output=$(node out/smoke/core.js)
  test "$output" = "smoke 3"

  printf '(ns smoke.extra)\n(println "extra")\n' > src/smoke/extra.cljs
  printf 'import "./smoke/extra.cljs";\n' > src/entry.js
  printf '<!doctype html>\n<script type="module" src="/src/smoke/core.cljs"></script>\n<script type="module" src="/src/entry.js"></script>\n' > index.html
  printf '%s\n' "import cljf from 'clojurific/vite';" \
    "export default {" \
    "  plugins: [cljf({ outputDir: 'target/cljs' })]," \
    "  // the polyfill needs a document, the bundle runs in Node.js here" \
    "  build: { modulePreload: { polyfill: false } }," \
    "};" > vite.config.mjs
  npx vite build --logLevel warn
  # the page's scripts, imported in order as a browser runs them, print what
  # the namespaces did
  scripts=$(sed -n 's|.*<script[^>]*src="/\([^"]*\.js\)".*|dist/\1|p' dist/index.html)
  test -n "$scripts"
  output=$(node --input-type=module -e "
    import { pathToFileURL } from 'node:url';
    for (const script of process.argv.slice(1)) await import(pathToFileURL(script).href);" $scripts)
  test "$output" = "$(printf 'smoke 3\nextra')"

  # the plugin's types (vite-plugin-cljs/index.d.ts): a TypeScript config
  # type checks, and wrong options don't. skipLibCheck: Vite's own types need
  # @types/node, which the project doesn't install
  npm install --silent --no-audit --no-fund typescript@5.9.3
  printf '%s\n' '{"compilerOptions": {"strict": true, "module": "nodenext", "moduleResolution": "nodenext",' \
    '  "target": "es2022", "noEmit": true, "skipLibCheck": true, "types": []},' \
    '  "files": ["vite.config.ts"]}' > tsconfig.json
  printf '%s\n' "import { defineConfig } from 'vite';" \
    "import cljf from 'clojurific/vite';" \
    "export default defineConfig(({ command }) => ({" \
    "  plugins: [cljf({ outputDir: 'target/cljs', ignoreWarnings: command === 'serve', compilerOptions: {" \
    "    buildHooks: [[\"'my.build/hook\", { outputTo: 'out.css' }]]," \
    "    closureDefines: { 'goog.DEBUG': true }," \
    "    ...(command === 'serve' && { repl: { nreplPort: 0, middleware: [\"'cider.nrepl/cider-middleware\"] } }) } })]," \
    "}));" > vite.config.ts
  npx tsc -p .
  printf '%s\n' "import cljf from 'clojurific/vite';" "cljf({ outputDir: 'out', prune: 'yes' });" > vite.config.ts
  ! npx tsc -p . > /dev/null
)

# the templates' projects get this version's jar from the local Maven
# repository above through the user's deps.edn
repo=$(pwd)
mkdir -p "$project/clj-config"
printf '{:mvn/local-repo "%s"}\n' "$project/m2" > "$project/clj-config/deps.edn"
for template in vanilla react reagent uix hono; do
  (
    cd "$project"
    npm exec --yes --package="$repo/builds/create-clojurific-$version.tgz" -- \
      create-clojurific "create-$template" --template "$template" --no-interactive > /dev/null
    cd "create-$template"
    test -f .gitignore
    npm install --silent --no-audit --no-fund "$repo/builds/clojurific-$version.tgz"
    output=$(CLJ_CONFIG="$project/clj-config" npx vite build --logLevel warn 2>&1)
    # Rolldown's warnings, i.e. [IMPORT_IS_UNDEFINED]
    if echo "$output" | grep -q '\[[A-Z_]*\]'; then
      echo "$output"
      exit 1
    fi
    if [ "$template" = hono ]; then
      # a Node.js server, its app bundled in
      grep -q 'Hello Hono!' dist/index.js
      # the dev server runs it despite a compiler warning, and releases the
      # output held back in its environment once it's fixed
      CLJ_CONFIG="$project/clj-config" node "$repo/src/main/js/vite-plugin-cljs/test/dev-server.mjs"
    else
      grep -q "create-$template.core" dist/manifest.json
    fi
    echo "create-clojurific $template: ok"
  )
done
echo "npm packages: ok"
